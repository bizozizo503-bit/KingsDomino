using UnityEditor;
using UnityEditor.SceneManagement;
using UnityEngine;
using TMPro;
using UnityEngine.TextCore.LowLevel;
using System.IO;

namespace KingsDominos.Editor
{
    [InitializeOnLoad]
    public static class KingsDominosAutoSetup
    {
        private const string FontPath =
            "Assets/KingsDominos/Fonts/ArabicArial.ttf";

        private const string CharactersPath =
            "Assets/KingsDominos/Fonts/ArabicCharacters.txt";

        private const string OutputFolder =
            "Assets/Resources/KingsDominosFonts";

        private const string FontAssetPath =
            OutputFolder + "/ArabicArial SDF.asset";

        private const string ScenePath =
            "Assets/KingsDominos/Scenes/SC_Lobby.unity";

        static KingsDominosAutoSetup()
        {
            EditorApplication.delayCall += Run;
        }

        private static void Run()
        {
            if (EditorApplication.isCompiling ||
                EditorApplication.isUpdating)
            {
                EditorApplication.delayCall += Run;
                return;
            }

            CreateArabicFont();
            EnsureLobbyScene();

            AssetDatabase.SaveAssets();
            AssetDatabase.Refresh();

            Debug.Log(
                "KingsDominos AUTO SETUP: Finished."
            );
        }

        private static void CreateArabicFont()
        {
            if (AssetDatabase.LoadAssetAtPath<TMP_FontAsset>(FontAssetPath) != null)
            {
                Debug.Log(
                    "KingsDominos: ArabicArial SDF already exists."
                );
                return;
            }

            Font sourceFont =
                AssetDatabase.LoadAssetAtPath<Font>(FontPath);

            if (sourceFont == null)
            {
                Debug.LogError(
                    "KingsDominos: ArabicArial.ttf not found: " +
                    FontPath
                );
                return;
            }

            if (!AssetDatabase.IsValidFolder("Assets/Resources"))
            {
                AssetDatabase.CreateFolder(
                    "Assets",
                    "Resources"
                );
            }

            if (!AssetDatabase.IsValidFolder(OutputFolder))
            {
                AssetDatabase.CreateFolder(
                    "Assets/Resources",
                    "KingsDominosFonts"
                );
            }

            AssetDatabase.Refresh();

            TMP_FontAsset fontAsset =
                TMP_FontAsset.CreateFontAsset(
                    sourceFont,
                    90,
                    9,
                    GlyphRenderMode.SDFAA,
                    2048,
                    2048
                );

            if (fontAsset == null)
            {
                Debug.LogError(
                    "KingsDominos: Could not create Arabic SDF."
                );
                return;
            }

            fontAsset.name = "ArabicArial SDF";

            AssetDatabase.CreateAsset(
                fontAsset,
                FontAssetPath
            );

            AssetDatabase.SaveAssets();

            if (File.Exists(CharactersPath))
            {
                string characters =
                    File.ReadAllText(CharactersPath).Trim();

                if (!string.IsNullOrEmpty(characters))
                {
                    uint[] missingCharacters;

                    bool result =
                        fontAsset.TryAddCharacters(
                            characters,
                            out missingCharacters
                        );

                    Debug.Log(
                        "KingsDominos: Arabic characters added. " +
                        "Success=" + result +
                        " Missing=" +
                        (missingCharacters == null
                            ? 0
                            : missingCharacters.Length)
                    );
                }
            }

            EditorUtility.SetDirty(fontAsset);

            AssetDatabase.SaveAssets();
            AssetDatabase.Refresh();

            Debug.Log(
                "KingsDominos: ArabicArial SDF created at " +
                FontAssetPath
            );
        }

        private static void EnsureLobbyScene()
        {
            if (!File.Exists(ScenePath))
            {
                Debug.LogWarning(
                    "KingsDominos: SC_Lobby.unity does not exist. " +
                    "Scene creation will be handled separately."
                );
                return;
            }

            Debug.Log(
                "KingsDominos: SC_Lobby.unity already exists."
            );
        }
    }
}
