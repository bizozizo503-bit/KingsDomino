using System.IO;
using UnityEditor;
using UnityEngine;
using TMPro;
using UnityEngine.TextCore.LowLevel;

public static class ArabicFontSetup
{
    private const string FontPath =
        "Assets/KingsDominos/Fonts/ArabicArial.ttf";

    private const string CharactersPath =
        "Assets/KingsDominos/Fonts/ArabicCharacters.txt";

    private const string OutputFolder =
        "Assets/Resources/KingsDominosFonts";

    private const string AssetPath =
        OutputFolder + "/ArabicArial SDF.asset";

    [MenuItem("Tools/KingsDominos/Create Arabic Font Asset")]
    public static void CreateArabicFontAsset()
    {
        Debug.Log("KingsDominos: Starting Arabic Font Asset creation...");

        Font sourceFont =
            AssetDatabase.LoadAssetAtPath<Font>(FontPath);

        if (sourceFont == null)
        {
            Debug.LogError(
                "KingsDominos: ArabicArial.ttf not found:\n" +
                FontPath
            );
            return;
        }

        if (!AssetDatabase.IsValidFolder("Assets/Resources"))
        {
            AssetDatabase.CreateFolder("Assets", "Resources");
        }

        if (!AssetDatabase.IsValidFolder(OutputFolder))
        {
            AssetDatabase.CreateFolder(
                "Assets/Resources",
                "KingsDominosFonts"
            );
        }

        AssetDatabase.Refresh();

        if (AssetDatabase.LoadAssetAtPath<TMP_FontAsset>(AssetPath) != null)
        {
            Debug.Log(
                "KingsDominos: Removing old Arabic SDF..."
            );

            AssetDatabase.DeleteAsset(AssetPath);
            AssetDatabase.Refresh();
        }

        TMP_FontAsset fontAsset =
            TMP_FontAsset.CreateFontAsset(
                sourceFont,
                90,
                9,
                GlyphRenderMode.SDFAA,
                2048,
                2048
            );

        if (fontAsset == null)
        {
            Debug.LogError(
                "KingsDominos: Failed to create TMP Font Asset."
            );
            return;
        }

        fontAsset.name = "ArabicArial SDF";

        AssetDatabase.CreateAsset(
            fontAsset,
            AssetPath
        );

        AssetDatabase.SaveAssets();
        AssetDatabase.Refresh();

        // Add Arabic characters
        if (File.Exists(CharactersPath))
        {
            string characters =
                File.ReadAllText(CharactersPath);

            if (!string.IsNullOrWhiteSpace(characters))
            {
                characters = characters.Trim();

                uint[] missingCharacters;

                bool success =
                    fontAsset.TryAddCharacters(
                        characters,
                        out missingCharacters
                    );

                Debug.Log(
                    "KingsDominos: Arabic characters processed. " +
                    "Success = " + success +
                    ", Missing = " +
                    (missingCharacters == null
                        ? 0
                        : missingCharacters.Length)
                );
            }
            else
            {
                Debug.LogWarning(
                    "KingsDominos: ArabicCharacters.txt is empty."
                );
            }
        }
        else
        {
            Debug.LogWarning(
                "KingsDominos: ArabicCharacters.txt not found:\n" +
                CharactersPath
            );
        }

        EditorUtility.SetDirty(fontAsset);

        AssetDatabase.SaveAssets();
        AssetDatabase.Refresh();

        Debug.Log(
            "KingsDominos: ArabicArial SDF CREATED SUCCESSFULLY.\n" +
            "Location:\n" +
            AssetPath
        );
    }
}

